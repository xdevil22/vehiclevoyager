{
  "redirects": [
    {
      "source": "/cookie-policy",
      "destination": "/cookiepolicy",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/termsofuse",
      "permanent": true
    },
    {
      "source": "/terms-of-use",
      "destination": "/termsofuse",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "vehiclevoyager.com"}],
      "destination": "https://vechura.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "www.vehiclevoyager.com"}],
      "destination": "https://vechura.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "www.vechura.com"}],
      "destination": "https://vechura.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/$1"},
    {"source": "/(.*)", "destination": "/"}
  ]
}
